<style>

/* 🔒 تغطية الموقع بالكامل أثناء تسجيل الدخول */
body.locked #loginOverlay {

    position:fixed !important;

    top:0 !important;
    left:0 !important;
    right:0 !important;
    bottom:0 !important;

    width:100vw !important;
    height:100vh !important;

    min-width:100vw !important;
    min-height:100vh !important;

    display:flex !important;

    align-items:center !important;
    justify-content:center !important;

    z-index:2147483647 !important;

    visibility:visible !important;

    opacity:1 !important;

    pointer-events:auto !important;

}


/* 🚫 إخفاء كل محتوى الموقع أثناء الدخول */
body.locked > *:not(#loginOverlay) {

    visibility:hidden !important;

    pointer-events:none !important;

}


/* 🚫 إخفاء العناصر الثابتة والمطلقة */
body.locked .video-top-container-fixed,
body.locked #videoBoxFixed,
body.locked .userProfile,
body.locked [style*="position:fixed"],
body.locked [style*="position: fixed"],
body.locked [style*="position:absolute"],
body.locked [style*="position: absolute"] {

    visibility:hidden !important;

    pointer-events:none !important;

}


/* 🔐 محتويات نافذة الدخول تبقى ظاهرة */
body.locked #loginOverlay,
body.locked #loginOverlay * {

    visibility:visible !important;

}


/* 🌑 منع التمرير خلف نافذة الدخول */
body.locked {

    overflow:hidden !important;

}

</style>
