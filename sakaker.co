    measurementId:
    "G-0LGSW71V74"
};


/* =========================================================
   FIREBASE INITIALIZE
========================================================= */

const app =
    initializeApp(firebaseConfig);

const db =
    getDatabase(app);

const auth =
    getAuth(app);


/* =========================================================
   SHADOW DOM
========================================================= */

const host =
    document.getElementById(
        "sakaker-public-chat"
    );

const shadow =
    host.attachShadow({
        mode: "open"
    });


/* =========================================================
   HTML + CSS
========================================================= */

shadow.innerHTML = `

