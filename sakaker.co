</button>

<script>
// 🎨 تغيير ألوان الخلفية كل ثانية
const pongBtn = document.getElementById('pongGame-btn');
setInterval(() => {
  const colors = [
    'linear-gradient(45deg, #ff1493, #ff69b4)',
    'linear-gradient(45deg, #007bff, #00ffff)',
    'linear-gradient(45deg, #00ffcc, #0066ff)',
    'linear-gradient(45deg, #ff9900, #ff6600)',
    'linear-gradient(45deg, #00ff00, #009933)',
  ];
