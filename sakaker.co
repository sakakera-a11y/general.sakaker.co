            <div id="usersHeader">

                👥 الموجودون الآن
                (<span id="onlineCount">0</span>)

            </div>

            <div id="usersList"></div>

        </aside>


        <!-- MAIN -->

        <main id="main">

            <div id="room">

                <span id="roomName">
                    💬 الدردشة العامة
                </span>

                <span id="connection">
