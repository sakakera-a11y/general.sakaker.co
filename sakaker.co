                    id="enterChat"
                    class="actionButton">

                    دخول

                </button>

            </div>


            <!-- SEND -->

            <div id="sendArea">

                <input
                    id="messageInput"
                    class="chatInput"
                    type="text"
                    maxlength="300"
                    autocomplete="off"
                    placeholder="اكتب رسالتك... 20 كلمة كحد أقصى">

                <button
                    id="sendButton"
                    class="actionButton">

                    إرسال

                </button>

            </div>

        </main>

    </div>

</div>
`;


/* =========================================================
   ELEMENTS
========================================================= */

const $ =
    id => shadow.getElementById(id);

const chatButton =
    $("chatButton");

const chatWindow =
    $("chatWindow");

const closeButton =
    $("closeButton");

const languageButton =
    $("languageButton");

const userNameInput =
    $("userNameInput");

const enterChat =
    $("enterChat");

const messageInput =
    $("messageInput");

const sendButton =
    $("sendButton");

const loginArea =
    $("loginArea");

const sendArea =
    $("sendArea");

const messages =
    $("messages");

const welcome =
    $("welcome");

const usersList =
    $("usersList");

const onlineCount =
    $("onlineCount");

const connection =
    $("connection");


/* =========================================================
   SETTINGS
========================================================= */

const MESSAGE_LIFETIME =
    5 * 60 * 1000;

const MAX_WORDS =
    20;


/* =========================================================
   STATE
========================================================= */

let currentUser =
    null;

let myName =
    "";

let myUserRef =
    null;

let language =
    "ar";

let listenersStarted =
    false;


/* =========================================================
   TRANSLATIONS
========================================================= */

const translations = {

    ar: {

        lang:
        "English",

        title:
        "🌊 دردشة سكاكر",

        subtitle:
        "الدردشة العامة",

        users:
        "👥 الموجودون الآن",

        room:
        "💬 الدردشة العامة",

        info:
        "الرسائل تختفي بعد 5 دقائق",

        welcome:
        "أهلاً بك في الدردشة العامة<br>اكتب اسمًا مستعارًا للانضمام",

        name:
        "اكتب اسمك المستعار",

        join:
        "دخول",

        joining:
        "جاري الدخول...",

        message:
        "اكتب رسالتك... 20 كلمة كحد أقصى",

        send:
        "إرسال",

        sending:
        "إرسال...",

        connected:
        "● متصل",

        disconnected:
        "● غير متصل",

        connecting:
        "● جاري الاتصال",

        nameError:
        "اكتب اسمًا من حرفين على الأقل",

        wait:
        "انتظر حتى يتم الاتصال بالدردشة",

        onlineError:
        "تعذر تسجيل الاسم في قائمة الموجودين",

        sendError:
        "تعذر إرسال الرسالة",

        maxWords:
        "الرسالة يجب ألا تتجاوز 20 كلمة",

        empty:
        "اكتب رسالة أولًا"

    },

    en: {

        lang:
        "العربية",

        title:
        "🌊 Sakaker Chat",

        subtitle:
        "Public Chat",

        users:
        "👥 Online Users",

        room:
        "💬 Public Chat",

        info:
        "Messages disappear after 5 minutes",

        welcome:
        "Welcome to the public chat<br>Enter a nickname to join",

        name:
        "Enter your nickname",

        join:
        "Join",

        joining:
        "Joining...",

        message:
        "Write your message... Max 20 words",

        send:
        "Send",

        sending:
        "Sending...",

        connected:
        "● Connected",

        disconnected:
        "● Disconnected",

        connecting:
        "● Connecting",

        nameError:
        "Enter a name with at least 2 characters",

        wait:
        "Please wait for the chat connection",

        onlineError:
        "Unable to register your name",

        sendError:
        "Unable to send the message",

        maxWords:
        "The message cannot exceed 20 words",

        empty:
        "Write a message first"

    }

};


/* =========================================================
   LANGUAGE
========================================================= */

function applyLanguage(){

    const t =
        translations[language];

    languageButton.textContent =
        t.lang;

    $("title").textContent =
        t.title;

    $("subtitle").textContent =
        t.subtitle;

    $("usersHeader").childNodes[0]
        .textContent =
        t.users + " ";

    $("roomName").textContent =
        t.room;

    $("roomInfo").textContent =
        t.info;

    $("welcomeText").innerHTML =
        t.welcome;

    userNameInput.placeholder =
        t.name;

    messageInput.placeholder =
        t.message;

    enterChat.textContent =
        t.join;

    sendButton.textContent =
        t.send;

    connection.textContent =
        currentUser
        ? t.connected
        : t.connecting;

    host.dir =
        language === "ar"
        ? "rtl"
        : "ltr";
}

languageButton.onclick =
function(){

    language =
        language === "ar"
        ? "en"
        : "ar";

    applyLanguage();

};


/* =========================================================
   OPEN / CLOSE
========================================================= */

chatButton.onclick =
function(){

    chatWindow.style.display =
        "flex";

    chatButton.style.display =
        "none";

    setTimeout(
        () => userNameInput.focus(),
        100
    );

};


closeButton.onclick =
function(){

    chatWindow.style.display =
        "none";

    chatButton.style.display =
        "block";

};


/* =========================================================
   WORD COUNT
========================================================= */

function getWordCount(text){

    return text
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .length;

}


/* =========================================================
   FIREBASE LOGIN
========================================================= */

signInAnonymously(auth)

.then(result => {

    currentUser =
        result.user;

    connection.textContent =
        translations[
            language
        ].connected;

    connection.style.color =
        "#21e58a";

    console.log(
        "Firebase UID:",
        currentUser.uid
    );

    startRealtimeListeners();

})

.catch(error => {

    console.error(
        "Firebase Authentication Error:",
        error
    );

    connection.textContent =
        translations[
            language
        ].disconnected;

    connection.style.color =
        "#ff6666";

});


/* =========================================================
   LISTENERS
========================================================= */

function startRealtimeListeners(){

    if(listenersStarted){

        return;

    }

    listenersStarted =
        true;


    onValue(

        ref(
            db,
            "onlineUsers"
        ),

        renderOnlineUsers,

        error => {

            console.error(
                "Online users error:",
                error
            );

        }

    );


    onChildAdded(

        query(
            ref(
                db,
                "publicChat"
            ),

            limitToLast(100)

        ),

        renderMessage,

        error => {

            console.error(
                "Public chat error:",
                error
            );

        }

    );

}


/* =========================================================
   USERS
========================================================= */

function renderOnlineUsers(snapshot){

    usersList.replaceChildren();

    let count =
        0;


    snapshot.forEach(
        child => {

            const data =
                child.val();

            if(
                !data ||
                typeof data.name !==
                "string"
            ){

                return;

            }


            count++;


            const item =
                document.createElement(
                    "div"
                );

            item.className =
                "chatUser";


            const dot =
                document.createElement(
                    "span"
                );

            dot.className =
                "onlineDot";


            const name =
                document.createElement(
                    "span"
                );

            name.textContent =
                data.name;


            item.append(
                dot,
                name
            );

            usersList.appendChild(
                item
            );

        }
    );


    onlineCount.textContent =
        count;

}


/* =========================================================
   MESSAGE RENDER
========================================================= */

function renderMessage(snapshot){

    const data =
        snapshot.val();


    if(
        !data ||
        typeof data.text !==
        "string"
    ){

        return;

    }


    /*
       إذا كانت الرسالة انتهت
       نحاول حذفها مباشرة.
    */

    if(
        data.expiresAt &&
        Date.now() >=
        Number(data.expiresAt)
    ){

        remove(snapshot.ref)
        .catch(
            error =>
            console.error(
                "Expired message:",
                error
            )
        );

        return;

    }


    welcome.style.display =
        "none";


    const message =
        document.createElement(
            "div"
        );

    message.className =
        "chatMessage";


    const username =
        document.createElement(
            "div"
        );

    username.className =
        "messageUser";

    username.textContent =
        data.name ||
        "Visitor";


    const text =
        document.createElement(
            "div"
        );

    text.className =
        "messageText";

    text.textContent =
        data.text;


    message.append(
        username,
        text
    );


    messages.appendChild(
        message
    );


    messages.scrollTop =
        messages.scrollHeight;


    /*
       حذف الرسالة من الواجهة
       بعد انتهاء الخمس دقائق.
    */

    if(data.expiresAt){

        const remaining =
            Number(data.expiresAt) -
            Date.now();


        if(remaining > 0){

            setTimeout(
                async () => {

                    try{

                        await remove(
                            snapshot.ref
                        );

                        if(
                            message.parentNode
                        ){

                            message.remove();

                        }

                    }catch(error){

                        console.error(
                            "Message expiration:",
                            error
                        );

                    }

                },
                remaining
            );

        }

    }

}


/* =========================================================
   REGISTER USER
========================================================= */

async function registerOnlineUser(){

    if(
        !currentUser ||
        !myName
    ){

        return false;

    }


    myUserRef =
        ref(
            db,
            `onlineUsers/${currentUser.uid}`
        );


    try{

        /*
           نسجل المستخدم أولًا.
        */

        await set(
            myUserRef,
            {

                name:
                myName,

                uid:
                currentUser.uid,

                joinedAt:
                Date.now()

            }
        );


        /*
           ثم نحدد أن Firebase
           يحذف المستخدم عند
           انقطاع الاتصال.
        */

        await onDisconnect(
            myUserRef
        ).remove();


        return true;


    }catch(error){

        console.error(
            "Register Online User Error:",
            error
        );

        return false;

    }

}


/* =========================================================
   ENTER CHAT
========================================================= */

async function enterPublicChat(){

    const name =
        userNameInput.value.trim();


    if(
        name.length < 2
    ){

        alert(
            translations[
                language
            ].nameError
        );

        return;

    }


    if(
        !currentUser
    ){

        alert(
            translations[
                language
            ].wait
        );

        return;

    }


    myName =
        name;


    enterChat.disabled =
        true;

    enterChat.textContent =
        translations[
            language
        ].joining;


    const success =
        await registerOnlineUser();


    enterChat.disabled =
        false;


    if(!success){

        enterChat.textContent =
            translations[
                language
            ].join;

        alert(
            translations[
                language
            ].onlineError
        );

        return;

    }


    loginArea.style.display =
        "none";

    sendArea.style.display =
        "flex";


    messageInput.focus();

}


enterChat.onclick =
enterPublicChat;


userNameInput.addEventListener(
    "keydown",
    event => {

        if(
            event.key === "Enter"
        ){

            event.preventDefault();

            enterPublicChat();

        }

    }
);


/* =========================================================
   SEND MESSAGE
========================================================= */

async function sendPublicMessage(){

    const text =
        messageInput.value.trim();


    if(!text){

        alert(
            translations[
                language
            ].empty
        );

        return;

    }


    const words =
        getWordCount(text);


    if(
        words > MAX_WORDS
    ){

        alert(
            translations[
                language
            ].maxWords
        );

        return;

    }


    if(
        !currentUser ||
        !myName
    ){

        return;

    }


    sendButton.disabled =
        true;

    sendButton.textContent =
        translations[
            language
        ].sending;


    try{

        const messageRef =
            push(
                ref(
                    db,
                    "publicChat"
                )
            );


        /*
           الرسالة تنتهي بعد 5 دقائق.
        */

        const expiresAt =
            Date.now() +
            MESSAGE_LIFETIME;


        await set(
            messageRef,
            {

                name:
                myName,

                text:
                text,

                timestamp:
                serverTimestamp(),

                expiresAt:
                expiresAt,

                uid:
                currentUser.uid

            }
        );


        messageInput.value =
            "";


    }catch(error){

        console.error(
            "Send Message Error:",
            error
        );

        alert(
            translations[
                language
            ].sendError
        );

    }


    sendButton.disabled =
        false;

    sendButton.textContent =
        translations[
            language
        ].send;

    messageInput.focus();

}


sendButton.onclick =
sendPublicMessage;


messageInput.addEventListener(
    "keydown",
    event => {

        if(
            event.key === "Enter"
        ){

            event.preventDefault();

            sendPublicMessage();

        }

    }
);


/* =========================================================
   START
========================================================= */

applyLanguage();

</script>

</body>
</html>
```

