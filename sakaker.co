    color:#ffd700;

    letter-spacing:1px;
}


/* =========================================================
   CHAT WINDOW
========================================================= */

#chatWindow{

    position:fixed;

    left:50%;
    top:50%;

    transform:
    translate(-50%,-50%);

    width:850px;
    height:650px;

    max-width:
    calc(100vw - 24px);

    max-height:
    calc(100vh - 24px);

    display:none;

    flex-direction:column;

    overflow:hidden;

    border-radius:24px;

    border:
    1px solid
    rgba(255,215,0,.45);

    background:#021923;

    color:#fff;

    font-family:
    Tahoma,
    Arial,
    sans-serif;

    box-shadow:
    0 0 50px rgba(0,0,0,.9),
    0 0 100px rgba(0,170,230,.28);

    z-index:1000000;
}


/* =========================================================
   SEA BACKGROUND
========================================================= */

#sea{

    position:absolute;

    inset:0;

    z-index:0;

    overflow:hidden;

    background:
    linear-gradient(
        180deg,
        #07577a 0%,
        #064865 38%,
        #032a3c 70%,
        #01151f 100%
    );
}

#sea:before{

    content:"";

    position:absolute;

    width:220%;
    height:70%;

    left:-60%;
    bottom:-35%;

    background:
    repeating-radial-gradient(
        ellipse at center,
        rgba(255,255,255,.20) 0 2px,
        transparent 3px 23px
    );

    opacity:.23;

    animation:
    seaMove 15s linear infinite;
}

@keyframes seaMove{

    0%{
        transform:translateX(0);
    }

    100%{
        transform:translateX(-12%);
    }

}


/* =========================================================
   HEADER
========================================================= */

#header{

    position:relative;

    z-index:5;

    height:75px;

    flex-shrink:0;

    display:flex;

    align-items:center;

    justify-content:center;

    background:
    rgba(0,12,20,.82);

    border-bottom:
    1px solid
    rgba(255,215,0,.18);
}

#title{

    color:#fff;

    font-size:22px;

    font-weight:bold;

    text-align:center;

    text-shadow:
    0 0 12px #36d7ff;
}

#subtitle{

    color:#7fd9ee;

    font-size:10px;

    margin-top:4px;

    text-align:center;
}

#closeButton{

    position:absolute;

    left:14px;
    top:15px;

    width:42px;
    height:42px;

    border-radius:50%;

    border:
    1px solid
    rgba(255,255,255,.25);

    background:
    rgba(0,0,0,.45);

    color:#fff;

    font-size:25px;

    cursor:pointer;
}

#languageButton{

    position:absolute;

    right:14px;
    top:17px;

    padding:7px 13px;

    border-radius:18px;

    border:
    1px solid
    rgba(255,215,0,.35);

    background:
    rgba(0,20,30,.85);

    color:#ffd700;

    cursor:pointer;

    font-size:11px;
}


/* =========================================================
   BODY
========================================================= */

#body{

    position:relative;

    z-index:3;

    flex:1;

    min-height:0;

    display:grid;

    grid-template-columns:200px 1fr;
}


/* =========================================================
   USERS
========================================================= */

#usersPanel{

    min-height:0;

    display:flex;

    flex-direction:column;

    background:
    rgba(0,8,15,.58);

    border-left:
    1px solid
    rgba(255,255,255,.10);
}

#usersHeader{

    flex-shrink:0;

    padding:15px 5px;

    text-align:center;

    color:#8deaff;

    font-size:13px;

    border-bottom:
    1px solid
    rgba(255,255,255,.10);
}

#onlineCount{

    color:#ffd700;

    font-weight:bold;
}

#usersList{

    flex:1;

    min-height:0;

    overflow-y:auto;

    padding:9px;
}

.chatUser{

    display:flex;

    align-items:center;

    gap:8px;

    padding:10px;

    margin-bottom:6px;

    border-radius:10px;

    background:
    rgba(255,255,255,.07);

    color:#fff;

    font-size:12px;
}

.onlineDot{

    width:8px;
    height:8px;

    border-radius:50%;

    background:#21e58a;

    box-shadow:
    0 0 10px #21e58a;
}


/* =========================================================
   MAIN
========================================================= */

#main{

    min-width:0;
    min-height:0;

    display:flex;

    flex-direction:column;
}

#room{

    flex-shrink:0;

    padding:10px 15px;

    background:
    rgba(0,0,0,.20);

    border-bottom:
    1px solid
    rgba(255,255,255,.08);
}

#roomName{

    color:#fff;

    font-size:13px;

    font-weight:bold;
}

#roomInfo{

    margin-top:3px;

    color:#7eb5c4;

    font-size:9px;
}

#connection{

    float:left;

    color:#ffd700;

    font-size:9px;
}


/* =========================================================
   MESSAGES
========================================================= */

#messages{

    flex:1;

    min-height:0;

    overflow-y:auto;

    padding:15px;

    display:flex;

    flex-direction:column;

    gap:9px;
}

.chatMessage{

    max-width:82%;

    padding:10px 13px;

    border-radius:14px;

    background:
    rgba(255,255,255,.08);

    border:
    1px solid
    rgba(100,220,255,.13);

    animation:
    messageIn .2s ease;
}

@keyframes messageIn{

    from{
        opacity:0;
        transform:translateY(5px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.messageUser{

    margin-bottom:4px;

    color:#67ddff;

    font-size:10px;

    font-weight:bold;
}

.messageText{

    color:#fff;

    font-size:13px;

    line-height:1.65;

    white-space:pre-wrap;

    word-break:break-word;
}

#welcome{

    margin:auto;

    text-align:center;

    color:#8ab2bf;

    font-size:12px;

    line-height:2;
}

#welcomeIcon{

    font-size:45px;
}


/* =========================================================
   INPUT
========================================================= */

#loginArea,
#sendArea{

    flex-shrink:0;

    display:flex;

    gap:7px;

    padding:11px;

    background:
    rgba(0,0,0,.35);

    border-top:
    1px solid
    rgba(255,255,255,.10);
}

#sendArea{

    display:none;
}

.chatInput{

    flex:1;

    min-width:0;

    padding:11px 13px;

    border-radius:10px;

    border:
    1px solid
    rgba(100,220,255,.3);

    outline:none;

    background:
    rgba(0,8,15,.9);

    color:#fff;

    font-family:
    Tahoma,
    Arial,
    sans-serif;

    font-size:13px;
}

.chatInput:focus{

    border-color:
    rgba(100,220,255,.8);
}

.actionButton{

    padding:
    0 20px;

    border:none;

    border-radius:10px;

    background:
    linear-gradient(
        135deg,
        #18aeda,
        #07547e
    );

    color:#fff;

    font-weight:bold;

    cursor:pointer;
}

.actionButton:disabled{

    opacity:.55;

    cursor:wait;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:700px){

    #chatButton{

        width:100px;
        height:100px;
    }

    #chatButton .chatIcon{

        font-size:32px;
    }

    #chatButton .chatText{

        font-size:14px;
    }

    #chatWindow{

        width:
        calc(100vw - 12px);

        height:
        calc(100vh - 12px);

        max-width:none;

        max-height:none;

        border-radius:18px;
    }

    #header{

        height:64px;
    }

    #title{

        font-size:17px;
    }

    #body{

        grid-template-columns:1fr;

        grid-template-rows:82px 1fr;
    }

    #usersPanel{

        border-left:none;

        border-bottom:
        1px solid
        rgba(255,255,255,.10);
    }

    #usersHeader{

        padding:6px;
    }

    #usersList{

        display:flex;

        gap:6px;

        overflow-x:auto;

        overflow-y:hidden;

        padding:5px;
    }

    .chatUser{

        white-space:nowrap;

        margin:0;

        padding:7px 10px;
    }

    .chatMessage{

        max-width:92%;
    }

    .actionButton{

        padding:
        0 14px;
    }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media(max-width:420px){

    #languageButton{

        right:8px;

        padding:6px 8px;

        font-size:9px;
    }

    #closeButton{

        left:8px;

        width:36px;
        height:36px;

        font-size:20px;
    }

    #title{

        font-size:15px;
    }

    .chatInput{

        font-size:12px;
    }

    .actionButton{

        padding:
        0 11px;

        font-size:11px;
    }

}

</style>


<!-- =======================================================
     CHAT BUTTON
======================================================== -->

<button id="chatButton">

    <span class="chatIcon">
        💬
    </span>

    <span class="chatText">
        CHAT
    </span>

</button>


<!-- =======================================================
     CHAT WINDOW
======================================================== -->

<div id="chatWindow">

    <div id="sea"></div>


    <div id="header">

        <button id="closeButton">
            ×
        </button>

        <button id="languageButton">
            English
        </button>

        <div>

            <div id="title">
                🌊 دردشة سكاكر
            </div>

            <div id="subtitle">
                الدردشة العامة
            </div>

        </div>

    </div>


    <div id="body">


        <!-- USERS -->

