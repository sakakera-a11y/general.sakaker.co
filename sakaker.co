<div class="video-top-container-fixed">

  <div class="video-circle" data-video="n7eQejkXbnM">
    <div class="circle-glow"></div>
    <div class="circle-shine"></div>

    <iframe class="miniVideo"
      src="https://www.youtube.com/embed/n7eQejkXbnM?autoplay=1&mute=1&playsinline=1&controls=0&loop=1&playlist=n7eQejkXbnM"
