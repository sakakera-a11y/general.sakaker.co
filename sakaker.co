    signInAnonymously
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


/* =========================================================
   FIREBASE CONFIG
========================================================= */

const firebaseConfig = {

    apiKey:
    "AIzaSyCltuh24M0X4KBlVpIFi8HXlrTObQRVk_s",

    authDomain:
    "general-sakaker.firebaseapp.com",

    databaseURL:
    "https://general-sakaker-default-rtdb.asia-southeast1.firebasedatabase.app",

