    messagingSenderId:
    "999891768564",

    appId:
    "1:999891768564:web:9821008d91378788b93aa1",

    measurementId:
    "G-0LGSW71V74"
};


/* =========================================================
   FIREBASE INITIALIZE
========================================================= */

const app =
    initializeApp(firebaseConfig);

const db =
    getDatabase(app);

const auth =
    getAuth(app);


/* =========================================================
   SHADOW DOM
========================================================= */

const host =
    document.getElementById(
        "sakaker-public-chat"
    );

const shadow =
    host.attachShadow({
        mode: "open"
    });


/* =========================================================
   HTML + CSS
========================================================= */

shadow.innerHTML = `

<style>

*{
    box-sizing:border-box;
}

#chatButton{

    position:fixed;

    left:50%;
    top:50%;

    transform:
    translate(-50%,-50%);

    width:115px;
    height:115px;

    border-radius:50%;

    border:
    2px solid #ffd700;

    background:
    radial-gradient(
        circle at 35% 30%,
        #1689b8,
        #063b58 45%,
        #01151f 100%
    );

    color:#fff;

    font-family:
    Arial,
    Tahoma,
