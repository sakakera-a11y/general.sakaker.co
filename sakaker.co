      frameborder="0"
      allow="autoplay; encrypted-media">
    </iframe>
  </div>

  <div class="video-circle" data-video="-EEHXzLNS6o">
    <div class="circle-glow"></div>
    <div class="circle-shine"></div>

    <iframe class="miniVideo"
      src="https://www.youtube.com/embed/-EEHXzLNS6o?autoplay=1&mute=1&playsinline=1&controls=0&loop=1&playlist=-EEHXzLNS6o"
      title="YouTube video player"
      frameborder="0"
      allow="autoplay; encrypted-media">
    </iframe>
  </div>

</div>


<!-- ====== مربع الفيديو ====== -->
<div id="videoBoxFixed">

  <div class="video-box-border"></div>

  <button id="videoCloseBtn" onclick="closeFixedVideo()">✕</button>

  <iframe id="fixedVideo" src="" allowfullscreen></iframe>

</div>


<style>

/* =====================================================
   الدوائر العلوية
===================================================== */

.video-top-container-fixed {
  position: fixed;
  top: 250px;
  left: 0;
  width: 100%;
  box-sizing: border-box;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 0 28px;

  z-index: 50000;

  pointer-events: none;
}


/* =====================================================
   الدائرة
===================================================== */

.video-circle {

  width: 125px;
  height: 105px;

  border-radius: 50%;

  position: relative;

  overflow: hidden;

  cursor: pointer;

  pointer-events: auto;

  background: rgba(0,0,0,.35);

  border: 2px solid rgba(0,255,200,.75);

  box-shadow:

    0 0 8px rgba(0,255,200,.9),
    0 0 20px rgba(0,255,200,.7),
    0 0 40px rgba(0,255,200,.45),
    inset 0 0 20px rgba(0,255,200,.25);

  transition:
    transform .35s ease,
    box-shadow .35s ease;

  isolation: isolate;

  animation: emeraldPulse 2.5s ease-in-out infinite;
}


/* =====================================================
   بريق الدائرة الخارجي
===================================================== */

.video-circle::before {

  content: "";

  position: absolute;

  inset: -4px;

  border-radius: 50%;

  border: 2px solid transparent;

  border-top-color: #00ffcc;
  border-right-color: #ffd700;

  filter:
    drop-shadow(0 0 5px #00ffcc)
    drop-shadow(0 0 10px #ffd700);

  animation: rotateRing 3s linear infinite;

  z-index: 5;

  pointer-events: none;
}


/* =====================================================
   الحلقة الثانية
===================================================== */

.video-circle::after {

  content: "";

  position: absolute;

  inset: 6px;

  border-radius: 50%;

  border: 1px solid rgba(255,215,0,.7);

  box-shadow:
    0 0 8px rgba(255,215,0,.8),
    inset 0 0 12px rgba(255,215,0,.25);

  z-index: 4;

  pointer-events: none;
}


/* =====================================================
   الفيديو داخل الدائرة
===================================================== */

.miniVideo {

  position: absolute;

  width: 160%;
  height: 160%;

  top: -30%;
  left: -30%;

  border: none;

  pointer-events: none;

  opacity: .88;

  z-index: 1;

  transform: scale(1.03);

  transition:
    transform .5s ease,
    opacity .5s ease;
}


/* =====================================================
   الوهج الداخلي
===================================================== */

.circle-glow {

  position: absolute;

  inset: 0;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      transparent 35%,
      rgba(0,255,200,.08) 60%,
      rgba(0,255,200,.25) 100%
    );

  z-index: 2;

  pointer-events: none;
}


/* =====================================================
   انعكاس زجاجي
===================================================== */

.circle-shine {

  position: absolute;

  top: -60%;

  left: -80%;

  width: 45%;

  height: 220%;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,.55),
    transparent
  );

  transform: rotate(25deg);

  z-index: 6;

  pointer-events: none;

  animation: shineMove 4s ease-in-out infinite;
}


/* =====================================================
   عند تمرير الماوس
===================================================== */

.video-circle:hover {

  transform: scale(1.16);

  box-shadow:

    0 0 12px #00ffcc,
    0 0 30px #00ffcc,
    0 0 60px rgba(255,215,0,.8),
    inset 0 0 25px rgba(0,255,200,.4);

  border-color: #ffd700;
}


.video-circle:hover .miniVideo {

  transform: scale(1.10);

  opacity: 1;
}


/* =====================================================
   عند الضغط
===================================================== */

.video-circle:active {

  transform: scale(.96);

  box-shadow:

    0 0 15px #ffd700,
    0 0 45px #00ffcc;
}


/* =====================================================
   مربع الفيديو
===================================================== */

#videoBoxFixed {

  position: fixed;

  top: 50px;
  left: 50%;

  transform: translateX(-50%);

  width: 330px;
  height: 200px;

  background: #000;

  border-radius: 18px;

  overflow: hidden;

  display: none;

  z-index: 49999;

  border: 2px solid rgba(0,255,200,.8);

  box-shadow:

    0 0 10px #00ffcc,
    0 0 25px rgba(0,255,200,.8),
    0 0 50px rgba(255,215,0,.45);

  animation: videoAppear .35s ease;
}


/* =====================================================
   إطار متوهج داخل المربع
===================================================== */

.video-box-border {

  position: absolute;

  inset: 0;

  border-radius: 18px;

  border: 1px solid rgba(255,215,0,.6);

  box-shadow:
    inset 0 0 15px rgba(0,255,200,.3);

  pointer-events: none;

  z-index: 3;
}


/* =====================================================
   فيديو المربع
===================================================== */

#videoBoxFixed iframe {

  width: 100%;
  height: 100%;

  border: none;
}


/* =====================================================
   زر الإغلاق
===================================================== */

#videoCloseBtn {

  position: absolute;

  top: 7px;
  right: 7px;

  width: 30px;
  height: 30px;

  border-radius: 50%;

  border: 1px solid rgba(255,215,0,.8);

  background: rgba(0,0,0,.75);

  color: #ffd700;

  font-size: 15px;

  font-weight: bold;

  cursor: pointer;

  z-index: 10;

  transition: .3s;

  box-shadow:
    0 0 8px rgba(255,215,0,.6);
}


#videoCloseBtn:hover {

  color: #fff;

  background: rgba(255,0,0,.75);

  border-color: #fff;

  box-shadow:
    0 0 15px red;

  transform: rotate(90deg) scale(1.1);
}


/* =====================================================
   الحركات
===================================================== */

@keyframes rotateRing {

  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }

}


@keyframes shineMove {

  0% {
    left: -100%;
    opacity: 0;
  }

  20% {
    opacity: 1;
  }

  50% {
    left: 150%;
    opacity: 1;
  }

  70% {
    opacity: 0;
  }

  100% {
    left: 150%;
    opacity: 0;
  }

}


@keyframes emeraldPulse {

  0%,
  100% {

    box-shadow:
      0 0 8px rgba(0,255,200,.8),
      0 0 20px rgba(0,255,200,.55),
      0 0 35px rgba(0,255,200,.3);

  }

  50% {

    box-shadow:
      0 0 12px #00ffcc,
      0 0 30px #00ffcc,
      0 0 55px rgba(255,215,0,.55);

  }

}


@keyframes videoAppear {

  from {

    opacity: 0;

    transform:
      translateX(-50%)
      scale(.75);

  }

  to {

    opacity: 1;

    transform:
      translateX(-50%)
      scale(1);

  }

}


/* =====================================================
   الجوال
===================================================== */

@media (max-width:600px) {

  .video-top-container-fixed {

    top: 180px;

    padding: 0 12px;

  }

  .video-circle {

    width: 90px;
    height: 78px;

  }

  #videoBoxFixed {

    width: 88%;
    height: 190px;

    top: 55px;

  }

}

</style>


<!-- ====== JavaScript ====== -->

<script>

document.querySelectorAll(".video-circle").forEach(circle => {

  circle.addEventListener("click", () => {

    const box =
      document.getElementById("videoBoxFixed");

    const iframe =
      document.getElementById("fixedVideo");

    const videoId =
      circle.getAttribute("data-video");


    /* إذا كان مفتوحًا */
    if (box.style.display === "block") {

      iframe.src = "";

      box.style.display = "none";

      return;

    }


    /* فتح الفيديو */

    iframe.src =
      `https://www.youtube.com/embed/${videoId}?autoplay=1&controls=1&playsinline=1`;

    box.style.display = "block";

  });

});


/* إغلاق الفيديو */

function closeFixedVideo() {

  const box =
    document.getElementById("videoBoxFixed");

  const iframe =
    document.getElementById("fixedVideo");

  iframe.src = "";

  box.style.display = "none";

}


/* =====================================================
   نظام الفيديو القديم
===================================================== */

function openVideoModal(videoId) {

  const modal =
    document.getElementById('videoModal');

  const modalVideo =
    document.getElementById('modalVideo');

  modalVideo.src =
    `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=0`;

  modal.style.display = 'flex';

}


function closeVideoModal() {

  const modal =
    document.getElementById('videoModal');

  const modalVideo =
    document.getElementById('modalVideo');

  modalVideo.src = '';

  modal.style.display = 'none';

}

</script>
<!-- Emerald Music Overlay START -->
<div id="emeraldMusicHost">
  <div id="emOpenBtn">🎹💎</div>
</div>

<style>
:root{--em:#00ffd5}

