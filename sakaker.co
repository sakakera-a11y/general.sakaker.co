<!-- سكربت القنوات المباشرة -->
<script>
  function toggleLivePopup() {
    const popup = document.getElementById("livePopup");
    if (!popup) return;
    popup.style.display = (popup.style.display === "block") ? "none" : "block";
  }

  function openVideo(url) {
    const overlay = document.getElementById("videoOverlay");
    const iframe = document.getElementById("mainVideo");
    if (!overlay || !iframe) return;
    iframe.src = url + (url.includes("?") ? "&" : "?") + "autoplay=1";
    overlay.style.display = "flex";
  }

  function closeVideo() {
    const overlay = document.getElementById("videoOverlay");
    const iframe = document.getElementById("mainVideo");
    if (!overlay || !iframe) return;
    iframe.src = "";
    overlay.style.display = "none";
  }
</script>

<!-- سكربت مكتبة الفيديو الزمردية -->
<script>
  // فتح / إغلاق المكتبة
  document.getElementById('emeraldLibraryButton').addEventListener('click', function() {
    const content = document.getElementById('emeraldLibraryContent');
    if (!content) return;
    content.style.display = (content.style.display === 'block') ? 'none' : 'block';

    if (content.style.display === 'block') {
      const sections = ['musicSection','docSection','cartoonSection','moviesSection',
                        'sportsSection','educationSection','religiousSection','gamesSection'];
      sections.forEach(id => {
        const sec = document.getElementById(id);
        if (sec) sec.style.display = 'none';
      });
    }
  });

  function toggleEmeraldSection(id) {
    const section = document.getElementById(id);
    if (!section) return;
    section.style.display = (section.style.display === 'flex' || section.style.display === 'block')
      ? 'none'
      : 'flex';
  }

  function openEmeraldVideo(url) {
    // إزالة مودال قديم
    const old = document.getElementById('emeraldModal');
    if (old) old.remove();

    const modal = document.createElement('div');
    modal.id = 'emeraldModal';

    const iframe = document.createElement('iframe');
    iframe.src = url + (url.includes("?") ? "&" : "?") + "autoplay=1";
    iframe.allow = "autoplay; encrypted-media; picture-in-picture";
    iframe.allowFullscreen = true;

    const closeBtn = document.createElement('button');
    closeBtn.id = 'emeraldModalClose';
    closeBtn.textContent = 'إغلاق ✖';
    closeBtn.onclick = () => modal.remove();

    modal.appendChild(iframe);
    modal.appendChild(closeBtn);
    document.body.appendChild(modal);
  }
</script>
<!-- ===========================
     Smart Mobile Fix Final v2.0
     ضع هذا قبل </body>
=========================== -->

<style>

@media screen and (max-width:768px){

html{
    -webkit-text-size-adjust:100%;
    scroll-behavior:smooth;
}

html,
body{
    margin:0;
    padding:0;
    width:100%;
    max-width:100%;
    overflow-x:hidden;
    padding-bottom:env(safe-area-inset-bottom);
}

*{
    box-sizing:border-box;
}

img,
video,
canvas,
iframe{
    max-width:100%!important;
    height:auto!important;
    display:block;
}

/* جميع النوافذ */
[id*="Popup"]{
    width:95%!important;
    max-width:95%!important;
    left:50%!important;
    top:50%!important;
    transform:translate(-50%,-50%)!important;
    max-height:90vh!important;
    overflow-y:auto!important;
}

/* جميع الأيقونات */
[id*="Icon"]{
    width:72px!important;
    height:72px!important;
    left:auto!important;
    right:12px!important;
    transition:.3s;
}

/* النصوص */
h1{font-size:24px!important;}
h2{font-size:21px!important;}
h3{font-size:19px!important;}

p,
li{
    font-size:16px!important;
    line-height:1.8!important;
}

/* الأزرار */
button{
    min-height:42px;
    font-size:16px;
}

}

</style>

<script>

(function(){

function mobileFix(){

    if(window.innerWidth>768) return;

    document.documentElement.style.overflowX="hidden";
    document.body.style.overflowX="hidden";

    /* ترتيب الأيقونات تلقائياً */

    const icons=[...document.querySelectorAll('[id*="Icon"]')];

    let bottom=20;

    icons.forEach(function(icon){

        if(getComputedStyle(icon).position==="fixed"){

            icon.style.left="auto";
            icon.style.right="12px";
            icon.style.bottom=bottom+"px";

            bottom+=82;

        }

    });

    /* إصلاح النوافذ */

    document.querySelectorAll('[id*="Popup"]').forEach(function(pop){

        pop.style.maxHeight="90vh";
        pop.style.overflowY="auto";

    });

}

/* تشغيل الإصلاح */

window.addEventListener("load",mobileFix);
window.addEventListener("resize",mobileFix);
window.addEventListener("orientationchange",function(){

    setTimeout(mobileFix,300);

});

/* دعم Safari و iPhone */

if(window.visualViewport){

    window.visualViewport.addEventListener("resize",mobileFix);

}

})();

</script>

<style>
/* ===== إصلاح شامل للجوال ===== */
@media only screen and (max-width:768px){

