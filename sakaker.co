                    </div>

                    <div id="welcomeText">
                        أهلاً بك في الدردشة العامة<br>
                        اكتب اسمًا مستعارًا للانضمام
                    </div>

                </div>

            </div>


            <!-- LOGIN -->

            <div id="loginArea">

                <input
                    id="userNameInput"
                    class="chatInput"
                    type="text"
                    maxlength="20"
                    autocomplete="off"
                    placeholder="اكتب اسمك المستعار">

