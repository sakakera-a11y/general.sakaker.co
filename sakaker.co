<!-- ================= نهاية الكود المنعزل ================= -->
  
<!-- 🐦 أيقونة صوت الطيور بتوهج زمردي -->
<div id="bird-sound-btn" title="تشغيل/إيقاف صوت الطيور" style="
  position: fixed;
  top: 460px;
  right: 202px;
  width: 75px;
  height: 75px;
  background:
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 34px;
  color: white;
  cursor: pointer;
  box-shadow: 0 0 25px rgba(0,255,200,0.9), 0 0 50px rgba(0,255,200,0.4);
  z-index: 1001;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
">
  🐦
</div>

<!-- 🎵 صوت تغريد الطيور وخرير الماء -->
<audio id="bird-sound" loop playsinline>
  <source src="https://www.orangefreesounds.com/wp-content/uploads/2016/04/Birds-chirping-and-water-flowing.mp3" type="audio/mp3">
  متصفحك لا يدعم تشغيل الصوت.
</audio>

<script>
const birdBtn = document.getElementById('bird-sound-btn');
const birdAudio = document.getElementById('bird-sound');

// حالة أولية
birdBtn.textContent = "🐦";

// عند النقر على الأيقونة
birdBtn.addEventListener('click', async () => {
  try {
    if (birdAudio.paused) {
      await birdAudio.play();
      birdBtn.textContent = "🔊";
      birdBtn.style.boxShadow = "0 0 35px rgba(0,255,200,1), 0 0 70px rgba(0,255,200,0.6)";
      birdBtn.style.transform = "scale(1.1)";
    } else {
      birdAudio.pause();
      birdBtn.textContent = "🐦";
      birdBtn.style.boxShadow = "0 0 25px rgba(0,255,200,0.9), 0 0 50px rgba(0,255,200,0.4)";
      birdBtn.style.transform = "scale(1)";
    }
  } catch (err) {
    console.error("حدث خطأ أثناء تشغيل الصوت:", err);
    alert("قد يمنع المتصفح التشغيل التلقائي. حاول النقر مرة أخرى.");
  }
});
</script>

<!DOCTYPE html>
