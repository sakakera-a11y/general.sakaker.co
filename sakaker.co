<style>
/* ====== الدوائر ====== */
.video-top-container-fixed {
  position: fixed;
  top: 250px;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 25px;
  z-index: 50000;
}

.video-circle {
  width:125px;
  height: 105px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  user-select: none;
  transition: 0.3s ease;
  overflow: hidden;
  font-size: 12px;
  border: 1px solid rgba(255,255,255,0.4);
  position: relative;
}

.video-circle:hover {
  transform: scale(1.1);
  background: rgba(255,255,255,0.2);
}

/* ====== الفيديو المصغّر داخل الدائرة ====== */
.miniVideo {
  position: absolute;
  width: 160%;
  height: 160%;
  top: -30%;
  left: -30%;
  border: none;
  pointer-events: none; /* يمنع مشاكل الضغط */
  opacity: 0.85;
}

/* ====== مربع الفيديو ====== */
#videoBoxFixed {
  position: fixed;
  top: 50px;
  left: 50%;
  transform: translateX(-50%);
  width: 330px;
  height: 200px;
  background: #000;
  border-radius: 14px;
  box-shadow: 0 0 20px rgba(0,255,255,0.5);
  display: none;
  z-index: 49999;
  overflow: hidden;
}

#videoBoxFixed iframe {
  width: 100%;
  height: 100%;
  border: none;
}
</style>

<!-- ====== سكربت الفتح والإغلاق ====== -->
<script>
document.querySelectorAll(".video-circle").forEach(circle => {
  circle.addEventListener("click", () => {
    const box = document.getElementById("videoBoxFixed");
    const iframe = document.getElementById("fixedVideo");
    const videoId = circle.getAttribute("data-video");

    // إغلاق إذا كان مفتوح
    if (box.style.display === "block") {
      iframe.src = "";
      box.style.display = "none";
      return;
    }

    // فتح المربع
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&controls=1&playsinline=1`;
    box.style.display = "block";
  });
});
</script>

<!-- ====== JavaScript ====== -->
<script>
function openVideoModal(videoId) {
  const modal = document.getElementById('videoModal');
  const modalVideo = document.getElementById('modalVideo');
  modalVideo.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=0`;
  modal.style.display = 'flex';
}

function closeVideoModal() {
  const modal = document.getElementById('videoModal');
  const modalVideo = document.getElementById('modalVideo');
  modalVideo.src = ''; // إيقاف الفيديو عند الإغلاق
  modal.style.display = 'none';
}
</script>
 
